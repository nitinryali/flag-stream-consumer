# HTTP
SERVER_PORT=8002

# Redis that carries the flag-updates channel.
# SPRING_DATA_REDIS_URL is the native Spring name; REDIS_URL is accepted as an
# alias and is overridden by the native name when both are set.
SPRING_DATA_REDIS_URL=redis://localhost:6379
# REDIS_URL=redis://localhost:6379

FLAG_CHANNEL=flag-updates

# Snapshot hydration, optional but strongly recommended: Pub/Sub has no replay,
# so a restarted consumer knows nothing until the next flag change.
# All four FLAGS_* values are required together; startup fails fast otherwise.
# FLAGS_SERVICE_URL=http://localhost:8001
# FLAGS_TENANT_ID=
# FLAGS_USERNAME=
# FLAGS_PASSWORD=
# FLAGS_SNAPSHOT_REFRESH_MS=300000
